# SmartShield AI Environment Configuration

# Server Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000/api/v1
CORS_ORIGIN=http://localhost:5173

# Authentication & Security
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# Database Configuration (Supabase / PostgreSQL)
# Leave blank or use local fallback mode for testing without live Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smartshield

# AI Provider Configuration (OpenAI or compatible)
# When not set, SmartShield AI gracefully utilizes its deterministic multi-agent rules engine
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Threat Intelligence Providers (Optional - will use offline fallback when unset)
GOOGLE_SAFE_BROWSING_API_KEY=
URLHAUS_API_KEY=

# Storage Configuration
STORAGE_DRIVER=local # 'local' or 'supabase'
LOCAL_UPLOAD_DIR=./uploads

# Emergency & Helpline Constants
NATIONAL_CYBERCRIME_HELPLINE=1930
OFFICIAL_CYBERCRIME_PORTAL=https://cybercrime.gov.in/
